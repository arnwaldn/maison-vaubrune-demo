# Laissez ces variables vides pour utiliser l'adaptateur de paiement simulé :
# la démonstration se construit, se teste et se déploie entièrement sans clé.
# Une clé Stripe DE TEST (préfixe sk_test_) suffit à activer le vrai tunnel ;
# aucune clé de production ne doit jamais approcher ce projet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_URL_SITE=http://localhost:3000
